@typeparam TValue
@inherits StateFieldBase<TValue>

@if (IsVisible)
{
    <StateFieldFrame Label="@Label" Component="@InputName" Helper="@Helper" Field="@FieldName" IsRequired="@IsRequired" IsReadOnly="@(!IsEditable)">
        <RadzenNumeric TValue="TValue" Name="@InputName" Value="@Value" ValueChanged="@((TValue number) => SetAsync(number))" ValueExpression="@(ValueExpression!)"
                       ReadOnly="@(!IsEditable)" ShowUpDown="@IsEditable" Min="@Min" Max="@Max" Format="@Format" Placeholder="@Placeholder" InputAttributes="@InputAttributes" />
    </StateFieldFrame>
}

@code {
    [Parameter] public decimal? Min { get; set; }

    [Parameter] public decimal? Max { get; set; }

    [Parameter] public string? Format { get; set; }
}
