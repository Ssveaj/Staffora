<li class="@(Done ? "home-check home-check--done" : "home-check home-check--open")" @attributes="AdditionalAttributes">
    <MaterialSymbol Name="@(Done ? "check_circle" : "radio_button_unchecked")" Class="home-check__mark" />
    <span class="home-check__text">
        <strong class="home-check__name">@Name</strong>
        @if (!string.IsNullOrWhiteSpace(Note))
        {
            <span class="home-check__note"> · @Note</span>
        }
        @ChildContent
    </span>
    @if (!string.IsNullOrWhiteSpace(Href))
    {
        <a class="home-link home-check__link" href="@Href">@LinkText</a>
    }
</li>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    [Parameter] public string? Note { get; set; }

    [Parameter] public bool Done { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string? Href { get; set; }

    [Parameter] public string? LinkText { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
