<section class="@CssClass" aria-labelledby="@(HasTitle ? TitleId : null)" @attributes="AdditionalAttributes">
    <div class="home-band__inner">
        @if (HasTitle)
        {
            <h2 class="home-band__title" id="@TitleId">@Title</h2>
        }
        @ChildContent
    </div>
</section>

@code {
    [Parameter] public string? Title { get; set; }

    [Parameter] public bool Muted { get; set; }

    [Parameter] public bool Head { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string titleId = $"home-band-{Guid.NewGuid():N}";

    private bool HasTitle => !string.IsNullOrWhiteSpace(Title);

    private string TitleId => this.titleId;

    private string CssClass => (Head, Muted) switch
    {
        (true, _) => "home-band home-band--head",
        (_, true) => "home-band home-band--muted",
        _ => "home-band",
    };
}
