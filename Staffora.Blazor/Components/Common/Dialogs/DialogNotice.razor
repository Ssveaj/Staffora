<div class="dialog-notice dialog-notice--@ToneClass">
    <div class="dialog-notice__icon">
        <MaterialSymbol Name="@Icon" Class="material-symbol--lg" />
    </div>
    <p class="dialog-notice__message">@Message</p>
    <div class="dialog-notice__buttons">
        @Buttons
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Message { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Icon { get; set; } = "info";

    [Parameter] public DialogTone Tone { get; set; } = DialogTone.Info;

    [Parameter, EditorRequired] public RenderFragment Buttons { get; set; } = null!;

    private string ToneClass => Tone.ToString().ToLowerInvariant();
}
