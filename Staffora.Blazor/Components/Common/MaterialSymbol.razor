<span class="@CssClass"
      aria-hidden="@(IsDecorative ? "true" : null)"
      role="@(IsDecorative ? null : "img")"
      aria-label="@(IsDecorative ? null : Label)"
      @attributes="AdditionalAttributes">@Name</span>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsDecorative => string.IsNullOrWhiteSpace(Label);

    private string CssClass => string.IsNullOrWhiteSpace(Class) ? "material-symbol" : $"material-symbol {Class}";
}
