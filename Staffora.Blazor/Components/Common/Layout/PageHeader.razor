@using Microsoft.AspNetCore.Components.Sections

<PageTitle>@DocumentTitle</PageTitle>

<SectionContent SectionName="@AppBreadcrumb.PageSection">
    <h1 class="page-header__title">@Title</h1>
    @if (Count is { } count)
    {
        <span class="page-header__count">@count</span>
    }
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <span class="page-header__help" data-page-help>
            <button type="button" class="page-header__help-button" aria-label="About this page" aria-expanded="false" aria-controls="@HelpId" data-page-help-toggle>
                <MaterialSymbol Name="help" />
            </button>
            <span id="@HelpId" class="page-header__help-pop" role="note" hidden>@Description</span>
        </span>
    }
</SectionContent>

@if (Meta is not null || Filters is not null || Actions is not null)
{
    <div class="page-header">
        @if (Meta is not null || Actions is not null)
        {
            <div class="page-header__lead">
                @if (Meta is not null)
                {
                    <div class="page-header__meta">
                        @Meta
                    </div>
                }
                @if (Actions is not null)
                {
                    <div class="page-header__actions">
                        @Actions
                    </div>
                }
            </div>
        }

        @if (Filters is not null)
        {
            <div class="page-header__filters">
                @Filters
            </div>
        }
    </div>
}

@code {
    public const string HelpId = "page-help";

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Description { get; set; }

    [Parameter] public string? Icon { get; set; }

    [Parameter] public string? RootText { get; set; }

    [Parameter] public string? RootPath { get; set; }

    [Parameter] public int? Count { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public RenderFragment? Filters { get; set; }

    [Parameter] public RenderFragment? Meta { get; set; }

    private string DocumentTitle => $"{Title} - Staffora";
}
