{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=stafforadb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Platform": {
    "TimeZone": "Europe/Stockholm"
  },
  "JobClock": {
    "Enabled": true
  },
  "IntegrationOutbox": {
    "Enabled": true
  },
  "Retention": {
    "Enabled": true,
    "ErrorLogDays": 90,
    "ReadNoticeDays": 180,
    "ProcessedOutboxDays": 30,
    "PendingDeletionGraceDays": 30,
    "BatchSize": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
